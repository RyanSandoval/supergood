    "/api/intake": {
      "post": {
        "operationId": "submitFitCheck",
        "tags": [
          "intake"
        ],
        "summary": "Submit one fit-check inquiry.",
        "description": "Emails the inquiry to Ryan Sandoval. Send one request per person. Send an Idempotency-Key header so a retry cannot send a second email. No auth. Browser pages on https://supergood.solutions receive Access-Control-Allow-Origin for this URL. The form at /start/ will not submit until 3 seconds after the first field focus. A body with elapsedMs under 3000 or a filled company field returns 200 and sends no email, so do not treat elapsedMs as a server-side lock. Leave company as an empty string. Put the employer in companyName. To test without sending anything, use POST /api/sandbox/intake.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FitCheckRequest"
              },
              "example": {
                "name": "Ada Lovelace",
                "email": "ada@example.com",
                "company": "",
                "companyName": "Example Co",
                "role": "Ops lead",
                "handoff": "A Monday report rebuilt by hand from three spreadsheets.",
                "currentState": "Entirely manual",
                "teamSize": "2-5",
                "timeline": "Next quarter",
                "budget": "$4k-$10k (one workflow)",
                "source": "supergood.solutions/start",
                "elapsedMs": 3000,
                "paysForTools": "Yes"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The inquiry was accepted. Ryan reads it and replies.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitCheckAccepted"
                }
              }
            },
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            }
          },
          "400": {
            "description": "The body or the Idempotency-Key header was rejected. error is json when the body is not a JSON object, required when name, email, or handoff is missing, email when the address is not valid, paysForTools when the value is not Yes, Not sure, or No, and idempotency_key when the Idempotency-Key header is not 1 to 200 printable characters with no spaces. Read hint, fix the request, and send once.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitCheckError"
                },
                "examples": {
                  "required": {
                    "summary": "Missing required field",
                    "value": {
                      "ok": false,
                      "error": "required",
                      "message": "Name, email and handoff are required.",
                      "hint": "Include non-empty \"name\", \"email\" and \"handoff\" (the work you want handed off)."
                    }
                  },
                  "email": {
                    "summary": "Email did not parse",
                    "value": {
                      "ok": false,
                      "error": "email",
                      "message": "The email address does not look valid.",
                      "hint": "Use an address like you@company.com."
                    }
                  },
                  "idempotency_key": {
                    "summary": "Bad Idempotency-Key",
                    "value": {
                      "ok": false,
                      "error": "idempotency_key",
                      "message": "The Idempotency-Key header is not valid.",
                      "hint": "Send 1 to 200 printable ASCII characters with no spaces, such as a UUID, or leave the header out."
                    }
                  }
                }
              }
            },
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            }
          },
          "403": {
            "description": "A browser request from an origin other than supergood.solutions. Call from a server, or use the form at /start/.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitCheckError"
                },
                "example": {
                  "ok": false,
                  "error": "origin",
                  "message": "Browser requests from this origin are not allowed.",
                  "hint": "Submit from https://supergood.solutions/start/, or call the API from a server (no Origin header)."
                }
              }
            },
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            }
          },
          "429": {
            "description": "More than 10 requests from one IP in 10 minutes. Retry-After gives the seconds to wait.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
