    "schemas": {
      "PricingDocument": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "url",
          "currency",
          "updated",
          "offers",
          "tooling"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code for the numeric prices."
          },
          "updated": {
            "type": "string",
            "description": "Calendar date the document was last edited, YYYY-MM-DD."
          },
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Offer"
            }
          },
          "tooling": {
            "type": "string"
          }
        }
      },
      "Offer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "unit",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "description": "Fixed price in currency. Present when the offer has a single price."
          },
          "priceFrom": {
            "type": "number",
            "description": "Lowest published price in currency. The quoted price can be higher."
          },
          "unit": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "creditedTowardBuildIfSignedWithinDays": {
            "type": "integer"
          },
          "gainSharePercent": {
            "$ref": "#/components/schemas/Range"
          },
          "gainShareCapMultiple": {
            "type": "number"
          },
          "minimumMonths": {
            "type": "integer"
          }
        }
      },
      "Range": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "min",
          "max"
        ],
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        }
      },
      "ServicesDocument": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "url",
          "updated",
          "services"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "updated": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            }
          }
        }
      },
      "Service": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "url",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "FitCheckRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email",
          "handoff"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Person to reply to."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "format": "email",
            "description": "Work email Ryan should reply to."
          },
          "handoff": {
            "type": "string",
            "minLength": 1,
            "description": "The manual work they want off the team's plate, in their words."
          },
          "paysForTools": {
            "type": "string",
            "enum": [
              "Yes",
              "Not sure",
              "No"
            ],
            "description": "Are you OK paying for the software and tools your workflows run on, on your own accounts? The form and the MCP tool require it. The endpoint accepts a request without it."
          },
          "company": {
            "type": "string",
            "const": "",
            "description": "Honeypot. Send an empty string. The employer name goes in companyName."
          },
          "companyName": {
            "type": "string",
            "description": "Employer. Optional."
          },
          "role": {
            "type": "string",
            "description": "Job title. Optional."
          },
          "currentState": {
            "type": "string",
            "enum": [
              "",
              "Entirely manual",
              "Spreadsheets and a few Zaps",
              "A pilot that stalled",
              "Running, but we don't trust it",
              "Not sure yet"
            ],
            "description": "Where the work sits today. Optional. Empty string if unknown."
          },
          "teamSize": {
            "type": "string",
            "enum": [
              "",
              "Just me",
              "2-5",
              "6-20",
              "20+"
            ],
            "description": "How many people touch the work. Optional."
          },
          "timeline": {
            "type": "string",
            "enum": [
              "",
              "Just exploring",
              "Next quarter",
              "Now, it's blocking us"
            ],
            "description": "When they want to move. Optional."
          },
          "budget": {
            "type": "string",
            "enum": [
              "",
              "Under $4k (Quick Scan only)",
              "$4k-$10k (one workflow)",
              "$10k+ (multiple workflows)",
              "Not sure yet"
            ],
            "description": "Rough budget. Optional."
          },
          "source": {
            "type": "string",
            "description": "Where the request came from. The form sends supergood.solutions/start. The in-page tool sends supergood.solutions/webmcp."
          },
          "elapsedMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Milliseconds since the person started the form. The function drops a value under 3000: it answers 200 and sends no email."
          }
        }
      },
      "FitCheckAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "description": "The inquiry was accepted. Also returned, with no email sent, when the form's spam checks drop it."
      },
      "FitCheckError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "error",
          "message",
          "hint"
        ],
        "description": "Every error from the intake function. error is a stable code, message says what went wrong, hint says how to fix it.",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string",
            "enum": [
              "method",
              "origin",
              "not_found",
              "json",
              "required",
              "email",
              "paysForTools",
              "idempotency_key",
              "idempotency_conflict",
              "idempotency_in_progress",
              "rate_limited",
              "server",
              "send"
            ]
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      },
      "SandboxAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "sandbox",
          "message"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "sandbox": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          }
        }
      },
      "IntakeIndex": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "name",
          "version",
          "docs",
          "openapi",
          "endpoints"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "docs": {
            "type": "string",
            "format": "uri"
          },
          "openapi": {
            "type": "string",
            "format": "uri"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "url",
                "description"
              ],
              "properties": {
                "method": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Optional. 1 to 200 printable ASCII characters, no spaces, such as a UUID. A retry with the same key and the same body within 24 hours does not send a second email. The same key with a different body returns 422 idempotency_conflict. Keys are scoped to the caller's IP address.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[\\x21-\\x7e]+$",
          "examples": [
            "3b241101-e2bb-4255-8caf-4136c566a962"
          ]
        }
      }
    },
    "headers": {
      "RateLimitLimit": {
        "description": "Requests allowed in the current window.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "RateLimitRemaining": {
        "description": "Requests left in the current window.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "RateLimitReset": {
        "description": "Seconds until the window resets.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "RateLimitPolicy": {
        "description": "The policy as limit;w=window-seconds, for example 10;w=600.",
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying. Sent on 429.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "APIVersion": {
        "description": "The API major version. Currently 1.",
        "schema": {
          "type": "string",
          "examples": [
            "1"
          ]
        }
      }
    }
  }
}
