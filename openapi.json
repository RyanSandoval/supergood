              }
            }
          },
          "405": {
            "description": "The method was not POST. Send POST with Content-Type application/json. A GET to this URL returns this error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitCheckError"
                },
                "example": {
                  "ok": false,
                  "error": "method",
                  "message": "This endpoint only accepts POST.",
                  "hint": "Send a POST request with a JSON body."
                }
              }
            },
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              },
              "Allow": {
                "description": "Allowed methods.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "The endpoint is not configured. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitCheckError"
                }
              }
            },
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            }
          },
          "502": {
            "description": "The email could not be delivered. Try again in a minute.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitCheckError"
                }
              }
            },
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            }
          },
          "409": {
            "description": "A request with this Idempotency-Key is still being processed. Wait a few seconds and retry with the same key.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitCheckError"
                },
                "example": {
                  "ok": false,
                  "error": "idempotency_in_progress",
                  "message": "A request with this Idempotency-Key is still being processed.",
                  "hint": "Wait a few seconds, then retry with the same key and body."
                }
              }
            }
          },
          "422": {
            "description": "This Idempotency-Key was already used with a different body. Use a new key for a different inquiry.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitCheckError"
                },
                "example": {
                  "ok": false,
                  "error": "idempotency_conflict",
                  "message": "This Idempotency-Key was already used with a different request body.",
                  "hint": "Use a new Idempotency-Key for a different request, or resend the original body."
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ]
      }
